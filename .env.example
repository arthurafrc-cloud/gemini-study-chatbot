# Copie este arquivo para ".env" e coloque sua chave de verdade.
# Gere a chave gratuitamente em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Opcional: troque o modelo sem mexer no codigo.
# Veja os modelos atuais em: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
